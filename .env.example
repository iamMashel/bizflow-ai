GEMINI_API_KEY=
DEFAULT_EMBEDDING_PROVIDER=gemini
DEFAULT_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# App
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=documents
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Database
DATABASE_URL=

# LiteLLM / Model Providers
LITELLM_API_BASE=
LITELLM_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_CHAT_PROVIDER=gemini
DEFAULT_CHAT_MODEL=gemini-2.5-flash

# n8n
N8N_BASE_URL=
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=
N8N_WORKFLOW_WEBHOOK_URL=

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# Security / Limits
MAX_UPLOAD_BYTES=20971520
ALLOWED_UPLOAD_CONTENT_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown,text/csv
